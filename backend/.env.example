PORT=8080
APP_ORIGIN=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# /admin（管理画面）と /explain（説明画面）に入るパスワード。空なら両方とも入れない。
# 長めのランダムな文字列にする（例: openssl rand -base64 24）。
ADMIN_PASSWORD=

# SQLite ファイルの場所。コンテナではボリュームを指す。
DB_PATH=./data/cokoyo.db

# compose がホスト側に開けるポート（他のサービスとぶつかる場合に変える）
# API_PORT=8090

# 1 でモック（MACから決定的に在校を組み立て、実APIを叩かない）。
MOCK_DTC=0
DTC_BASE_URL=https://api.dtc.wide.ad.jp

# 応答時間を揃えるための下限(ms)。仕様06。
TIMING_FLOOR_MS=250

# プッシュ通知の鍵（VAPID）。空なら初回起動時に作って DB（app_secrets）に保存する。
# 鍵を変えると、それまでに通知をオンにした端末に届かなくなる（オンにし直せば届く）。
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# キャンパスに着いた人に「ポイントを獲得しよう」と通知するため、8〜19時（日本時間）に5分おきに
# 通知をオンにしている人の端末を大学のAPIで引く。1人1日1回まで。0 で止める。
# ARRIVAL_WATCH=1
